{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users (admins and technicians)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "technician"] }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone"]
    },
    "Repair": {
      "title": "Repair",
      "description": "Equipment repair orders",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "equipment": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["PC", "Laptop", "Celular", "Impresora", "Tablet", "Otro"] },
            "brand": { "type": "string" },
            "model": { "type": "string" },
            "serial": { "type": "string" }
          },
          "required": ["type", "brand", "model"]
        },
        "status": { "type": "string", "enum": ["recibido", "diagnostico", "esperando_piezas", "reparado", "entregado"] },
        "notes": { "type": "string" },
        "photos": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "technicianId": { "type": "string" }
      },
      "required": ["customerId", "equipment", "status", "createdAt"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sales and quotes",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "items": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" }
            }
          }
        },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["cotizacion", "vendido"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["total", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory items",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "sku": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" }
      },
      "required": ["name", "price", "stock"]
    },
    "Activity": {
      "title": "Activity",
      "description": "System actions log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "timestamp"]
    }
  },
  "firestore": {

    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of system users"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Collection of clients"
    },
    "/repairs/{repairId}": {
      "schema": "Repair",
      "description": "Collection of repair orders"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Collection of sales and quotes"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of inventory items"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Log of system actions"
    },
    "/settings/business": {
      "schema": "object",
      "description": "Global business parameters"
    }
  }
}
